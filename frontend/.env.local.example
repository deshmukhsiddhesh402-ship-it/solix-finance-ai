# Environment Variables Template – Frontend
# Copy this to .env.local and fill in your credentials

# --- API Backend ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- NextAuth.js ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_very_long_random_secret_at_least_32_chars

# --- OAuth Providers ---
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx

MICROSOFT_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx
MICROSOFT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx

# --- Optional: Analytics ---
NEXT_PUBLIC_GA_ID=G-xxxxxxxxxxxxx
