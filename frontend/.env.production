# Production Environment Variables – Frontend
# Used in Railway / Kubernetes deployments

# --- Backend API ---
NEXT_PUBLIC_BACKEND_URL=https://solix-backend-production.railway.app

# --- NextAuth.js (OAuth) ---
NEXTAUTH_URL=https://solix.yourdomain.com
NEXTAUTH_SECRET=<generate: openssl rand -base64 32>

# --- OAuth Providers ---
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx

MICROSOFT_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx
MICROSOFT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx

# --- Optional: Analytics ---
NEXT_PUBLIC_GA_ID=G-xxxxxxxxxxxxx

# --- Security ---
NODE_ENV=production
