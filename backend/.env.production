# Production Environment Variables – Backend
# Used in Railway / Docker / Kubernetes deployments

# --- Database (Railway Postgres) ---
DATABASE_URL=postgresql://user:password@host:5432/solix_finance_ai

# --- Cache (Railway Redis) ---
REDIS_URL=redis://host:port

# --- AI / LLM ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# --- Optional: Embeddings for Semantic RAG ---
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxx

# --- Optional: Razorpay Billing ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxx

# --- Security ---
JWT_SECRET=<generate: openssl rand -base64 32>
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# --- CORS ---
ALLOWED_ORIGINS=https://solix.yourdomain.com,https://yourdomain.com
