# Environment Variables Template – Backend
# Copy this to .env and fill in your credentials

# --- Database ---
DATABASE_URL=postgresql://solix:your_secure_password@postgres:5432/solix_finance_ai
POSTGRES_USER=solix
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=solix_finance_ai

# --- Cache ---
REDIS_URL=redis://redis:6379/0

# --- AI / LLM ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# --- Embeddings (optional, for semantic RAG)
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxx

# --- Razorpay (optional, for billing)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxx

# --- Environment ---
ENV=development
# Local-only convenience; leave false in staging/production.
DEV_OTP_ENABLED=false
DEBUG=true
LOG_LEVEL=DEBUG

# --- CORS / Security ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
JWT_SECRET=your_very_long_random_jwt_secret_at_least_32_chars
