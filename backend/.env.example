# Backend local-development template. Never commit real credentials.
# Copy to backend/.env and replace values required by your local setup.

# --- Database ---
DATABASE_URL=postgresql://solix:local_dev_password@localhost:5432/solix_finance_ai
POSTGRES_USER=solix
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=solix_finance_ai

# --- Cache ---
REDIS_URL=redis://localhost:6379/0

# --- AI providers (optional; leave blank until configured) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Billing provider (optional; leave blank until configured) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Environment ---
ENV=development
# Local-only OTP disclosure must remain disabled unless explicitly needed for local development.
DEV_OTP_ENABLED=false
DEBUG=true
LOG_LEVEL=DEBUG

# --- CORS / Security ---
# Pydantic Settings expects a JSON array for List[str], not a comma-separated string.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
JWT_SECRET=local-development-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
